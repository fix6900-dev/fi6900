# Keeper API (ARCHITECTURE.md §5)
NEXT_PUBLIC_API_URL=http://localhost:8787
# Solana RPC used by wallet adapter + SDK
NEXT_PUBLIC_RPC_URL=https://api.mainnet-beta.solana.com
NEXT_PUBLIC_CLUSTER=mainnet-beta
# $FI6900 index mint (SPL, 6 decimals, mint authority = fund PDA)
NEXT_PUBLIC_INDEX_MINT=
# $FI pump.fun coin mint
NEXT_PUBLIC_COIN_MINT=
# fi6900 Anchor program id
NEXT_PUBLIC_PROGRAM_ID=
# Fund address lookup table (optional; otherwise read from the keeper /v1/verify)
NEXT_PUBLIC_LOOKUP_TABLE=
