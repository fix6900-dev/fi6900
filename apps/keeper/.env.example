# ---------------------------------------------------------------------------
# FI6900 keeper configuration. Copy to .env. Every value has a safe default
# except the ones marked REQUIRED (live mode only). MOCK_MODE needs nothing.
# ---------------------------------------------------------------------------

# Serve realistic fake data (no RPC, no keys). Use while building the web app.
MOCK_MODE=true

# Simulate every state-changing action and record it with sig "dry-run".
# Flip to false ONLY after the checklist in docs/operations.md.
DRY_RUN=true

NODE_ENV=development
LOG_LEVEL=info            # trace|debug|info|warn|error
LOG_PRETTY=true

# ---- chain -----------------------------------------------------------------
RPC_URL=https://api.mainnet-beta.solana.com
# RPC_WS_URL=
# HELIUS_API_KEY=         # optional; enables DAS holder snapshots + Helius RPC
COMMITMENT=confirmed
KEEPER_KEYPAIR=./keypairs/keeper.json        # REQUIRED (live): rebalancer / AP / fee_recipient
DEV_WALLET=./keypairs/dev-wallet.json        # pump.fun coin creator; runs the flywheel
# TREASURY_WALLET=                           # pubkey receiving 25% of ETF fees (SOL)
INDEX_MINT=                                  # REQUIRED (live): $FI6900 SPL mint (printed by `keeper init-fund`)
COIN_MINT=                                   # $FIX6900 pump.fun mint
# LOOKUP_TABLE=                              # printed by `keeper init-fund`
# METEORA_POOL=                              # DAMM v2 (cp-amm) pool $FI6900/SOL; if unset LP leg is held
PRIORITY_FEE_MICROLAMPORTS=50000

# ---- external APIs ---------------------------------------------------------
# PRICE_SOURCE=live                 # live (Jupiter+DexScreener) | static (offline JSON, localnet e2e; see docs/localnet-e2e.md)
# STATIC_PRICES_JSON=../../keypairs/localnet-prices.json
# Jupiter (verified live 2026-10-03). Without JUPITER_API_KEY every call goes to the free tier
# https://lite-api.jup.ag (nominally 60 req/min per IP; the client-side limiter spaces calls 2 s apart because 55/min still returns 429); with a key from
# https://portal.jup.ag the keeper uses https://api.jup.ag with the x-api-key header (100 ms between calls).
# JUPITER_API_KEY=
# JUPITER_MIN_INTERVAL_MS=2000
JUPITER_API_BASE=https://lite-api.jup.ag            # price: {base}/price/v3?ids=  (max 50 ids/call; v2 is gone)
JUPITER_QUOTE_BASE=https://lite-api.jup.ag/swap/v1  # /quote and /swap            (quote-api.jup.ag/v6 is gone)
JUPITER_TOKEN_LIST_URL=https://lite-api.jup.ag/tokens/v2   # /tag?query=verified, /search?query=  (tokens.jup.ag is gone)
DEXSCREENER_BASE=https://api.dexscreener.com
SOL_PRICE_FALLBACK_USD=150
# CoinGecko: the candidate universe is the "Solana Meme Coins" category (docs/methodology.md 2.6). No key needed on the
# public tier (~30 req/min, 10k calls/month; the keeper spaces calls 2100 ms apart and honours Retry-After). A free Demo
# key (https://www.coingecko.com/en/developers/dashboard) raises the monthly quota and is sent as x-cg-demo-api-key.
# COINGECKO_API_KEY=
# COINGECKO_PRO=false                # true + key = https://pro-api.coingecko.com with x-cg-pro-api-key
# COINGECKO_BASE=                    # override host (proxy); default follows COINGECKO_PRO
# COINGECKO_MIN_INTERVAL_MS=2100     # 150 when a key is set

# ---- storage / api ---------------------------------------------------------
DB_PATH=./data/keeper.db
PORT=8787
CORS_ORIGIN=*                                # or comma-separated origins

# ---- cadence ---------------------------------------------------------------
NAV_SNAPSHOT_SEC=60
METHODOLOGY_CRON=5 0 * * *                   # daily 00:05 UTC
REBALANCE_CHECK_SEC=60                       # drift check (cheap: reads the cached NAV snapshot)
ACTION_EXECUTE_SEC=60                        # executes due timelocked actions
AUCTION_MONITOR_SEC=15
AP_CHECK_SEC=30
DIST_INTERVAL_MIN=15                         # flywheel claim + airdrop
FEE_PROCESS_CRON=0 * * * *                   # hourly

# ---- methodology overrides (defaults in src/config/methodology.config.ts) ----
# UNIVERSE_SOURCE=coingecko                  # coingecko (CoinGecko category by mcap) | jupiter (verified list by volume) | merged
# COINGECKO_CATEGORY=solana-meme-coins
# UNIVERSE_MAX_CANDIDATES=150
# WEIGHTING_SCHEME=equal                     # equal | sqrt-cap | capped-cap
# REBALANCE_INTERVAL_DAYS=7
# DRIFT_RELATIVE_BPS=5000                   # interim rebalance when |actual-target|/target > 50%
# MAX_TRADE_PCT_DAILY_VOLUME=5

# ---- governance (ARCHITECTURE section 2/5) ----
# ADMIN_TOKEN=                               # bearer for POST /v1/admin/*; unset = admin API disabled
RECONSTITUTION_MODE=manual                   # manual (index committee approves proposals) | auto (keeper queues timelocked actions)
RECON_REJECT_COOLDOWN_DAYS=90                # rejected proposals are not re-proposed for this long
REF_PRICE_UPDATES=true                       # push on-chain ref prices after every NAV snapshot (rebalancer role)
REF_PRICE_MIN_CHANGE_BPS=25

# ---- AP arbitrage ----------------------------------------------------------
AP_ENABLED=true
AP_THRESHOLD_BPS=75
AP_NOTIONAL_SOL=2
AP_MAX_NOTIONAL_SOL_PER_CYCLE=10             # budget resets hourly
AP_SLIPPAGE_BPS=100
KILL_SWITCH=false                            # true = AP loop stops immediately

# ---- flywheel --------------------------------------------------------------
FLYWHEEL_ENABLED=true
MIN_CLAIM_SOL=0.05
AIRDROP_BATCH_SIZE=18
AIRDROP_DENYLIST=                            # comma-separated wallets never airdropped (LP pools, CEX, etc.)
ATA_RENT_LAMPORTS=2039280
FEE_BURN_PCT=75                              # % of fee proceeds used to buy+burn $FIX6900; rest to treasury
FEE_RESERVED_UNITS=0                         # raw index units in the keeper ATA that are NOT fees (bootstrap seed; printed by init-fund)
